{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/PabloAlaniz/omnilimit/spec/schemas/vector.schema.json",
  "title": "omnilimit conformance vector",
  "type": "object",
  "required": ["spec", "id", "kind"],
  "properties": {
    "spec": { "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["sequence", "key", "ip", "failure", "concurrency", "contract"] }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "sequence" } } },
      "then": {
        "required": ["tiers", "policy", "scope", "salt", "steps"],
        "properties": {
          "tiers": { "type": "array", "items": { "enum": ["exact", "local", "approximate"] } },
          "policy": { "$ref": "#/definitions/policy" },
          "scope": { "type": "string" },
          "salt": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["at_ms", "id"],
              "if": { "required": ["op"], "properties": { "op": { "const": "reset" } } },
              "then": { "not": { "required": ["expect"] } },
              "else": { "required": ["expect"] },
              "properties": {
                "at_ms": { "type": "integer" },
                "id": { "type": "string" },
                "op": { "enum": ["peek", "reset"], "description": "Absent means hit." },
                "expect": {
                  "allOf": [
                    { "$ref": "#/definitions/decision" },
                    {
                      "required": ["state"],
                      "properties": {
                        "state": {
                          "type": "object",
                          "required": ["level", "ts"],
                          "properties": { "level": { "type": "integer" }, "ts": { "type": "integer" } }
                        },
                        "headers": {
                          "type": "object",
                          "required": ["draft-11", "legacy"]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "key" } } },
      "then": { "required": ["cases"], "properties": { "cases": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "kind": { "const": "ip" } } },
      "then": {
        "required": ["cases", "masks"],
        "properties": {
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "headers", "peer", "strategy", "expect"],
              "properties": {
                "name": { "type": "string" },
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "peer": { "type": ["string", "null"] },
                "strategy": { "type": "object" },
                "expect": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "failure" } } },
      "then": {
        "required": ["fault", "on_store_error", "policy", "expect"],
        "properties": {
          "fault": { "enum": ["error", "timeout", "missing_binding"] },
          "on_store_error": { "enum": ["open", "closed"] },
          "policy": { "$ref": "#/definitions/policy" },
          "expect": { "$ref": "#/definitions/decision" }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "concurrency" } } },
      "then": { "required": ["policy", "scope", "salt", "id_value", "hits", "at_ms", "expect_allowed"] }
    },
    {
      "if": { "properties": { "kind": { "const": "contract" } } },
      "then": { "required": ["subject", "cases"], "properties": { "subject": { "enum": ["policy", "scope", "approximate"] } } }
    }
  ],
  "definitions": {
    "policy": {
      "type": "object",
      "required": ["limit", "window_ms", "burst"],
      "properties": {
        "limit": { "type": "number" },
        "window_ms": { "type": "number" },
        "burst": { "type": "number" }
      }
    },
    "decision": {
      "type": "object",
      "required": ["allowed", "reason", "status", "remaining", "reset_ms", "retry_after_ms", "headers"],
      "properties": {
        "allowed": { "type": "boolean" },
        "reason": { "enum": ["ok", "limited", "store_error"] },
        "status": { "enum": [null, 429, 503] },
        "remaining": { "type": ["integer", "null"] },
        "reset_ms": { "type": ["integer", "null"] },
        "retry_after_ms": { "type": ["integer", "null"] },
        "headers": { "type": "object" }
      }
    }
  }
}
