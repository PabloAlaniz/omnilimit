{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/PabloAlaniz/omnilimit/spec/schemas/vector.schema.json",
  "title": "omnilimit conformance vector",
  "type": "object",
  "required": ["spec", "id", "kind"],
  "properties": {
    "spec": { "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["sequence", "key", "ip", "failure", "concurrency", "contract", "recipe"] }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "sequence" } } },
      "then": {
        "required": ["tiers", "policy", "scope", "salt", "steps"],
        "properties": {
          "tiers": { "type": "array", "items": { "enum": ["exact", "local", "approximate"] } },
          "policy": { "$ref": "#/definitions/policy" },
          "scope": { "type": "string" },
          "salt": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["at_ms", "id"],
              "allOf": [
                {
                  "if": { "required": ["op"], "properties": { "op": { "const": "reset" } } },
                  "then": { "not": { "anyOf": [{ "required": ["expect"] }, { "required": ["of"] }] } }
                },
                {
                  "if": { "required": ["op"], "properties": { "op": { "const": "refund" } } },
                  "then": {
                    "required": ["of", "expect"],
                    "not": { "required": ["cost"] },
                    "properties": { "expect": { "$ref": "#/definitions/refund" } }
                  }
                },
                {
                  "if": { "not": { "required": ["op"], "properties": { "op": { "enum": ["reset", "refund"] } } } },
                  "then": {
                    "required": ["expect"],
                    "not": { "required": ["of"] },
                    "properties": {
                      "expect": {
                        "allOf": [
                          { "$ref": "#/definitions/decision" },
                          {
                            "required": ["state"],
                            "properties": {
                              "state": { "$ref": "#/definitions/state" },
                              "headers": {
                                "type": "object",
                                "required": ["draft-11", "legacy"]
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              ],
              "properties": {
                "at_ms": { "type": "integer" },
                "id": { "type": "string" },
                "op": { "enum": ["peek", "reset", "refund"], "description": "Absent means hit." },
                "cost": { "type": "integer", "minimum": 2, "description": "Absent means 1." },
                "of": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Refund only: the index of the earlier, allowed hit step it gives back."
                },
                "expect": { "type": "object" }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "key" } } },
      "then": { "required": ["cases"], "properties": { "cases": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "kind": { "const": "ip" } } },
      "then": {
        "required": ["cases", "masks"],
        "properties": {
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "headers", "peer", "strategy", "expect"],
              "properties": {
                "name": { "type": "string" },
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "peer": { "type": ["string", "null"] },
                "strategy": { "type": "object" },
                "expect": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "failure" } } },
      "then": {
        "required": ["fault", "on_store_error", "policy", "expect"],
        "properties": {
          "op": { "const": "refund", "description": "Absent means check. A refund fails after its hit succeeded." },
          "fault": { "enum": ["error", "timeout", "missing_binding"] },
          "on_store_error": { "enum": ["open", "closed"] },
          "policy": { "$ref": "#/definitions/policy" }
        },
        "if": { "required": ["op"] },
        "then": {
          "properties": {
            "fault": { "enum": ["error", "timeout"] },
            "expect": { "type": "object", "required": ["refunded"], "properties": { "refunded": { "const": false } }, "additionalProperties": false }
          }
        },
        "else": { "properties": { "expect": { "$ref": "#/definitions/decision" } } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "concurrency" } } },
      "then": { "required": ["policy", "scope", "salt", "id_value", "hits", "at_ms", "expect_allowed"] }
    },
    {
      "if": { "properties": { "kind": { "const": "contract" } } },
      "then": { "required": ["subject", "cases"], "properties": { "subject": { "enum": ["policy", "scope", "cost", "shorthand", "approximate"] } } }
    },
    {
      "if": { "properties": { "kind": { "const": "recipe" } } },
      "then": {
        "required": ["tiers", "salt", "limiters", "timeline"],
        "properties": {
          "tiers": { "type": "array", "items": { "enum": ["exact", "local"] } },
          "salt": { "type": "string" },
          "limiters": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": ["scope", "policy", "on_store_error"],
              "additionalProperties": false,
              "properties": {
                "scope": { "type": "string" },
                "policy": { "$ref": "#/definitions/policy" },
                "on_store_error": { "enum": ["open", "closed"] },
                "tier": { "const": "approximate", "description": "Absent means the store under test." }
              }
            }
          },
          "lockouts": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["limiter"],
                "additionalProperties": false,
                "properties": {
                  "limiter": { "type": "string" },
                  "reset_on_success": { "type": "boolean", "description": "Absent means true." }
                }
              }
            }
          },
          "timeline": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/recipe_step" } }
        }
      }
    }
  ],
  "definitions": {
    "short_decision": {
      "type": "object",
      "required": ["allowed", "reason", "status", "remaining", "reset_ms", "retry_after_ms"],
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "boolean" },
        "reason": { "enum": ["ok", "limited", "store_error"] },
        "status": { "enum": [null, 429, 503] },
        "remaining": { "type": ["integer", "null"] },
        "reset_ms": { "type": ["integer", "null"] },
        "retry_after_ms": { "type": ["integer", "null"] }
      }
    },
    "recipe_step": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": { "enum": ["check_all", "peek_all", "reserve_all", "commit", "cancel", "attempt", "check", "peek", "reset", "inspect", "fault", "heal"] },
        "handle": { "type": "string", "description": "The pending a peek_all or reserve_all opens, or a commit or cancel settles." },
        "at_ms": { "type": "integer", "description": "Passed to store calls as now, for this step and the ones after it." },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["limiter", "id"],
            "additionalProperties": false,
            "properties": {
              "limiter": { "type": "string" },
              "id": { "type": "string" },
              "cost": { "description": "Absent means 1. May be invalid on purpose." }
            }
          }
        },
        "lockout": { "type": "string" },
        "ids": { "type": "array", "items": { "type": "string" }, "description": "One id per limit of the lockout." },
        "verify": { "enum": [true, false, "raise"] },
        "limiter": { "type": "string" },
        "id": { "type": "string" },
        "cost": { "type": "integer" },
        "fault": { "enum": ["error", "timeout"] },
        "on": { "type": "array", "minItems": 1, "items": { "enum": ["peek", "hit", "reset", "refund"] } },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "calls": {
              "type": "array",
              "description": "Every store call of the step, in order.",
              "items": {
                "type": "object",
                "required": ["op", "limiter", "id"],
                "additionalProperties": false,
                "properties": {
                  "op": { "enum": ["peek", "hit", "reset", "refund"] },
                  "limiter": { "type": "string" },
                  "id": { "type": "string" },
                  "failed": { "const": true }
                }
              }
            },
            "result": {
              "oneOf": [
                { "type": "boolean", "description": "reset" },
                { "$ref": "#/definitions/short_decision" },
                {
                  "type": "object",
                  "required": ["allowed", "governing", "decisions"],
                  "additionalProperties": false,
                  "properties": {
                    "allowed": { "type": "boolean" },
                    "governing": { "type": "integer", "minimum": 0 },
                    "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/short_decision" } },
                    "verified": { "type": ["boolean", "null"] },
                    "verify_ran": { "type": "boolean" },
                    "refunded": { "$ref": "#/definitions/refunded", "description": "A pending: one value per decision." }
                  }
                },
                {
                  "type": "object",
                  "required": ["refunded"],
                  "additionalProperties": false,
                  "properties": { "refunded": { "$ref": "#/definitions/refunded", "description": "A cancel." } }
                }
              ]
            },
            "error": { "enum": ["value", "type", "state", "verify"], "description": "state: a settlement that rule 8 refuses." },
            "state": {
              "type": "object",
              "required": ["level", "ts"],
              "properties": { "level": { "type": "integer" }, "ts": { "type": "integer" } }
            }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "op": { "const": "check_all" } } }, "then": { "required": ["entries", "expect"] } },
        { "if": { "properties": { "op": { "enum": ["peek_all", "reserve_all"] } } }, "then": { "required": ["handle", "entries", "expect"] } },
        { "if": { "properties": { "op": { "enum": ["commit", "cancel"] } } }, "then": { "required": ["handle", "expect"] } },
        { "if": { "properties": { "op": { "const": "attempt" } } }, "then": { "required": ["lockout", "ids", "verify", "expect"] } },
        { "if": { "properties": { "op": { "enum": ["check", "peek", "reset"] } } }, "then": { "required": ["limiter", "id", "expect"] } },
        { "if": { "properties": { "op": { "const": "inspect" } } }, "then": { "required": ["limiter", "id", "expect"] } },
        { "if": { "properties": { "op": { "const": "fault" } } }, "then": { "required": ["limiter", "fault", "on"], "not": { "required": ["expect"] } } },
        { "if": { "properties": { "op": { "const": "heal" } } }, "then": { "required": ["limiter"], "not": { "required": ["expect"] } } }
      ]
    },
    "state": {
      "type": "object",
      "required": ["level", "ts"],
      "properties": { "level": { "type": "integer" }, "ts": { "type": "integer" } }
    },
    "refunded": {
      "type": "array",
      "items": { "type": ["boolean", "null"] },
      "description": "true: given back; false: the refund failed and it stays counted; null: nothing to give back."
    },
    "refund": {
      "type": "object",
      "required": ["refunded"],
      "additionalProperties": false,
      "properties": { "refunded": { "type": "boolean" }, "state": { "$ref": "#/definitions/state" } },
      "if": { "properties": { "refunded": { "const": true } } },
      "then": { "required": ["state"] },
      "else": { "not": { "required": ["state"] } }
    },
    "policy": {
      "type": "object",
      "required": ["limit", "window_ms", "burst"],
      "properties": {
        "limit": { "type": "number" },
        "window_ms": { "type": "number" },
        "burst": { "type": "number" }
      }
    },
    "decision": {
      "type": "object",
      "required": ["allowed", "reason", "status", "remaining", "reset_ms", "retry_after_ms", "headers"],
      "properties": {
        "allowed": { "type": "boolean" },
        "reason": { "enum": ["ok", "limited", "store_error"] },
        "status": { "enum": [null, 429, 503] },
        "remaining": { "type": ["integer", "null"] },
        "reset_ms": { "type": ["integer", "null"] },
        "retry_after_ms": { "type": ["integer", "null"] },
        "headers": { "type": "object" }
      }
    }
  }
}
